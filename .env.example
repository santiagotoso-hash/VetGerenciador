# Database
DATABASE_URL="postgresql://vetpet:vetpet123@localhost:5432/vetpet_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-key-here"
JWT_REFRESH_EXPIRES_IN="30d"

# App
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000

# Server
API_URL="http://localhost:3001"
# Deixe vazio para usar /api (mesma origem). Só defina se a API estiver em outro domínio.
NEXT_PUBLIC_API_URL=""

# E-mail (lembretes e confirmações de agendamento). Sem SMTP_HOST, nada é enviado.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="VetPet <no-reply@suaclinica.com>"
