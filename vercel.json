{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back": {
      "root": "back",
      "framework": "nestjs"
    },
    "front": {
      "root": "front",
      "framework": "nextjs"
    }
  },
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "back" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "front" }
    }
  ]
}
